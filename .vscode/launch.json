{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "GhostLedger AI: Run Server",
      "type": "debugpy",
      "request": "launch",
      "program": "${workspaceFolder}/run.py",
      "console": "integratedTerminal",
      "env": {
        "FLASK_ENV": "development",
        "FLASK_DEBUG": "1",
        "PORT": "5000",
        "PYTHONUNBUFFERED": "1"
      },
      "serverReadyAction": {
        "pattern": "Local Server: (http://127\\.0\\.0\\.1:\\d+)",
        "uriFormat": "%s",
        "action": "openExternally"
      }
    },
    {
      "name": "GhostLedger AI: Run Evaluation Benchmark",
      "type": "debugpy",
      "request": "launch",
      "program": "${workspaceFolder}/evaluate.py",
      "console": "integratedTerminal"
    },
    {
      "name": "GhostLedger AI: Run Pytest Tests",
      "type": "debugpy",
      "request": "launch",
      "module": "pytest",
      "args": [
        "-v",
        "tests/"
      ],
      "console": "integratedTerminal"
    }
  ]
}
