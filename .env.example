# GhostLedger AI Configuration
# Copy this file to .env for local overrides

# Flask Application Settings
FLASK_APP=run.py
FLASK_ENV=development
FLASK_DEBUG=1
SECRET_KEY=dev-ghostledger-secret-key-change-in-production-2026

# Database Connection
# Default fallback is SQLite in instance directory:
DATABASE_URL=sqlite:///ghostledger.db
# For MySQL 8 in production:
# DATABASE_URL=mysql+mysqlconnector://ghostledger_user:password@localhost:3306/ghostledger_db

# LLM Provider Configuration
# Supported providers: 'none' (deterministic rules engine), 'openai', 'anthropic', 'gemini'
LLM_PROVIDER=none
LLM_API_KEY=
LLM_MODEL=gpt-4o-mini
LLM_TEMPERATURE=0.0

# Security & Limits
MAX_CONTENT_LENGTH=10485760 # 10 MB upload limit
DEMO_MODE=true
RATE_LIMIT_PER_MINUTE=60
